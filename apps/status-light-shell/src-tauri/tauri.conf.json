{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Status Light",
  "version": "0.1.0",
  "identifier": "io.github.monstertulin.codex-status-light",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Status Light",
        "width": 420,
        "height": 520,
        "minWidth": 360,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
